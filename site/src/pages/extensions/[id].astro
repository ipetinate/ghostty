---
import Landing from "../../layouts/Landing.astro";
import Detail from "../../components/store/Detail.astro";
import { en } from "../../lib/copy";
import { extensions } from "../../lib/store";

export function getStaticPaths() {
  return extensions.map((extension) => ({
    params: { id: extension.id },
    props: { extension },
  }));
}

const { extension } = Astro.props;
---

<Landing
  copy={en}
  title={`${extension.name} — Phantom extensions`}
  description={extension.description}
>
  <Detail copy={en} extension={extension} />
</Landing>
