{
  "note": [
    "The shared conformance table for the Phantom glob dialect.",
    "Two byte-identical copies exist, and neither repository can read the other's:",
    "  phantom/macos/Tests/Terminal/Fixtures/glob-pattern-cases.json",
    "  phantom-extensions/packages/registry/test/glob-pattern-cases.json",
    "Both test suites hash this file and compare the digest against a constant they",
    "declare, so editing one copy fails that repository's tests until the digest is",
    "updated - which is the moment to copy the file across and update the other one.",
    "",
    "'accepted', 'rejected' and 'matches' are the contract of a manifest's",
    "contributes.languages[].fileNamePatterns: canonical, name-only, no separator.",
    "'paths' is the contract of the dialect itself, which a caller matching a whole",
    "path uses - '.editorconfig' section headers are the one this was written for."
  ],
  "limits": {
    "maxSourceLength": 64,
    "maxBranches": 16,
    "maxPatternsPerLanguage": 32,
    "maxCandidateLength": 255
  },
  "accepted": [
    {
      "pattern": ".env.*",
      "canonical": ".env.*",
      "branches": 1
    },
    {
      "pattern": ".env*",
      "canonical": ".env*",
      "branches": 1,
      "why": "the form .gitignore files declare"
    },
    {
      "pattern": ".env.*.local",
      "canonical": ".env.*.local",
      "branches": 1,
      "why": "two suffixes, so a star crosses a dot"
    },
    {
      "pattern": "*.env",
      "canonical": "*.env",
      "branches": 1
    },
    {
      "pattern": "*",
      "canonical": "*",
      "branches": 1
    },
    {
      "pattern": "?",
      "canonical": "?",
      "branches": 1
    },
    {
      "pattern": "**.kt",
      "canonical": "**.kt",
      "branches": 1,
      "why": "in a name there is no separator to cross"
    },
    {
      "pattern": ".env.{prod,dev1,staging}",
      "canonical": ".env.{prod,dev1,staging}",
      "branches": 3
    },
    {
      "pattern": "*.{tf,tfvars,hcl}",
      "canonical": "*.{tf,tfvars,hcl}",
      "branches": 3,
      "why": "an .editorconfig header, verbatim"
    },
    {
      "pattern": "{*test.kt,*tests.kt,*spec.kt}",
      "canonical": "{*test.kt,*tests.kt,*spec.kt}",
      "branches": 3,
      "why": "a brace list of patterns"
    },
    {
      "pattern": "a{b,c}d",
      "canonical": "a{b,c}d",
      "branches": 2
    },
    {
      "pattern": "{a}.env",
      "canonical": "{a}.env",
      "branches": 1,
      "why": "a list of one is the alternative itself"
    },
    {
      "pattern": "a,b.env",
      "canonical": "a,b.env",
      "branches": 1,
      "why": "a comma outside a list is a literal"
    },
    {
      "pattern": "{a,b}{c,d}{e,f}{g,h}",
      "canonical": "{a,b}{c,d}{e,f}{g,h}",
      "branches": 16,
      "why": "exactly maxBranches"
    },
    {
      "pattern": ".env.local",
      "canonical": ".env.local",
      "branches": 1,
      "why": "a wildcard is not required, only pointless"
    },
    {
      "pattern": "  .ENV.{PROD,DEV1}  ",
      "canonical": ".env.{prod,dev1}",
      "branches": 2,
      "why": "trimmed of spaces and tabs, then lower-cased"
    },
    {
      "pattern": "\t*.ENV\t",
      "canonical": "*.env",
      "branches": 1
    },
    {
      "pattern": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa*",
      "canonical": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa*",
      "branches": 1,
      "why": "exactly maxSourceLength scalars"
    },
    {
      "pattern": "caf?.txt",
      "canonical": "caf?.txt",
      "branches": 1,
      "why": "non-ASCII names are matched scalar by scalar"
    }
  ],
  "rejected": [
    {
      "pattern": "",
      "why": "empty"
    },
    {
      "pattern": "   ",
      "why": "empty once trimmed"
    },
    {
      "pattern": ".",
      "why": "the current directory is not a file name"
    },
    {
      "pattern": "..",
      "why": "the parent directory is not a file name"
    },
    {
      "pattern": ".env/*",
      "why": "a language's pattern sees a name, never a path"
    },
    {
      "pattern": "src\\*.env",
      "why": "a Windows-shaped path should not be writable either"
    },
    {
      "pattern": "[abc].txt",
      "why": "character classes are not in the dialect"
    },
    {
      "pattern": "[0-9].env",
      "why": "and neither are ranges"
    },
    {
      "pattern": "{a,b",
      "why": "an unclosed list"
    },
    {
      "pattern": "a}b",
      "why": "a close with no open"
    },
    {
      "pattern": "{}",
      "why": "a list with no alternatives"
    },
    {
      "pattern": "{a,}",
      "why": "an empty alternative; write the pattern without the list"
    },
    {
      "pattern": "{,a}",
      "why": "the same, at the front"
    },
    {
      "pattern": "{a,{b,c}}",
      "why": "lists do not nest; write a second pattern"
    },
    {
      "pattern": "{a,b}{c,d}{e,f}{g,h}{i,j}",
      "why": "32 branches, past maxBranches"
    },
    {
      "pattern": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa*",
      "why": "longer than maxSourceLength scalars"
    },
    {
      "pattern": ".env.‮lacol",
      "why": "a bidirectional override decides what the row appears to say"
    },
    {
      "pattern": ".env.\nlocal",
      "why": "a newline is a control scalar"
    },
    {
      "pattern": ".env.​local",
      "why": "a zero-width space is invisible padding"
    }
  ],
