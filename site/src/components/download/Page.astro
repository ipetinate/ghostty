---
import Footer from "../landing/Footer.astro";
import { Icon } from "astro-icon/components";
import { dmg, dmgArm64, releases } from "../../lib/site";
import { formatBytes } from "../../lib/store";
import type { Copy } from "../../lib/copy";
import downloads from "../../data/downloads.json";

interface Props {
  copy: Copy;
}

const { copy } = Astro.props;
const count = new Intl.NumberFormat(copy.htmlLang);

/** The two macOS builds sit side by side; anything else runs full width. */
const mac = [
  {
    ...copy.downloads.targets.universal,
    icon: "apple" as const,
    ready: downloads.targets.universal.available,
    href: downloads.targets.universal.available ? dmg : null,
    meta: downloads.targets.universal.available
      ? [
          `v${downloads.version}`,
          formatBytes(downloads.targets.universal.bytes),
          copy.downloads.checksum,
        ].filter((item) => item !== "—")
      : [],
  },
  {
    ...copy.downloads.targets.arm,
    icon: "apple" as const,
    ready: downloads.targets.arm.available,
    href: downloads.targets.arm.available ? dmgArm64 : null,
    meta: downloads.targets.arm.available
      ? [
          `v${downloads.version}`,
          formatBytes(downloads.targets.arm.bytes),
          copy.downloads.checksum,
        ].filter((item) => item !== "—")
      : [],
  },
];
const others = [
  {
    ...copy.downloads.targets.linux,
    icon: "linux" as const,
    ready: false,
    href: null,
    meta: [] as string[],
  },
];
---

<section class="downloads">
  <div class="shell">
    <h1 class="store__title">{copy.downloads.title}</h1>
    <p class="store__lede">{copy.downloads.lede}</p>

    {
      downloads.counter.known && downloads.counter.total > 0 && (
        <p class="store__meta">
          <strong>{count.format(downloads.counter.total)}</strong>{" "}
          {copy.downloads.counted} v{downloads.counter.since}
        </p>
      )
    }

    <ul class="targets targets--pair">
      {
        mac.map((target) => (
          <li class:list={["target", !target.ready && "target--soon"]}>
            <div class="target__head">
              <Icon name={`fa6-brands:${target.icon}`} class="target__icon" size={20} />
              <h2>{target.name}</h2>
              <span class="target__status">
                {target.ready ? copy.downloads.now : copy.downloads.soon}
              </span>
            </div>
            <p class="target__detail">{target.detail}</p>
            {target.meta.length > 0 && (
              <p class="target__meta">
                {target.meta.map((item, i) => (
                  <>
                    {i > 0 && <> &middot; </>}
                    <span>{item}</span>
                  </>
                ))}
              </p>
            )}
            {target.href && (
              <p class="target__action">
                <a class="btn btn--primary" href={target.href}>
                  {copy.downloads.get}
                </a>
                <a class="btn btn--ghost" href={releases}>
                  {copy.download.other}
                  <span class="btn__arrow" aria-hidden="true">
                    &rarr;
                  </span>
                </a>
              </p>
            )}
          </li>
        ))
      }
    </ul>

    <ul class="targets">
      {
        others.map((target) => (
          <li class:list={["target", !target.ready && "target--soon"]}>
            <div class="target__head">
              <Icon name={`fa6-brands:${target.icon}`} class="target__icon" size={20} />
              <h2>{target.name}</h2>
              <span class="target__status">
                {target.ready ? copy.downloads.now : copy.downloads.soon}
              </span>
            </div>
            <p class="target__detail">{target.detail}</p>
            {target.meta.length > 0 && (
              <p class="target__meta">
                {target.meta.map((item, i) => (
                  <>
                    {i > 0 && <> &middot; </>}
                    <span>{item}</span>
                  </>
                ))}
              </p>
            )}
            {target.href && (
              <p class="target__action">
                <a class="btn btn--primary" href={target.href}>
                  {copy.downloads.get}
                </a>
                <a class="btn btn--ghost" href={releases}>
                  {copy.download.other}
                  <span class="btn__arrow" aria-hidden="true">
                    &rarr;
                  </span>
                </a>
              </p>
            )}
          </li>
        ))
      }
    </ul>

    <div class="note">
      <h3>{copy.download.gatekeeperTitle}</h3>
      <p set:html={copy.download.gatekeeperBody} />
    </div>

    <div class="note">
      <h3>{copy.download.updatesTitle}</h3>
      <p set:html={copy.download.updatesBody} />
    </div>
  </div>
</section>

<Footer copy={copy} />
